{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "STRIPE_SECRET_KEY",
        "STRIPE_AUTOMATIC_TAX",
        "STRIPE_WEBHOOK_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_REPLY_TO",
        "BOOKING_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "STUDIO_URL",
        "STUDIO_PORT"
      ],
      "passThroughEnv": ["VERCEL", "VERCEL_*", "CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "E2E_MOCK_*",
        "STRIPE_*",
        "RESEND_API_KEY",
        "EMAIL_*",
        "BOOKING_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "STUDIO_URL",
        "STUDIO_PORT"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "E2E_MOCK_*",
        "STRIPE_*",
        "RESEND_API_KEY",
        "EMAIL_*",
        "BOOKING_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "STUDIO_URL",
        "STUDIO_PORT"
      ]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PORT",
        "PW_*",
        "PLAYWRIGHT_*",
        "E2E_MOCK_*",
        "STRIPE_*",
        "RESEND_API_KEY",
        "EMAIL_*",
        "BOOKING_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "STUDIO_URL",
        "STUDIO_PORT",
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY",
        "NEXT_PUBLIC_SUPABASE_*",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "test:db": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["SUPABASE_URL", "SUPABASE_SECRET_KEY", "NEXT_PUBLIC_SUPABASE_*"]
    },
    "@edit-issebya/studio#test:e2e": {
      "cache": false,
      "dependsOn": ["@edit-issebya/web#test:e2e"],
      "passThroughEnv": [
        "CI",
        "PORT",
        "PW_*",
        "PLAYWRIGHT_*",
        "E2E_MOCK_*",
        "STRIPE_*",
        "RESEND_API_KEY",
        "EMAIL_*",
        "BOOKING_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "STUDIO_URL",
        "STUDIO_PORT",
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY",
        "NEXT_PUBLIC_SUPABASE_*",
        "NEXT_PUBLIC_SITE_URL"
      ]
    }
  }
}
