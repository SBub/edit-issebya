# Placeholder names only. Copy to .env.local (read in every mode) and, for ADW,
# .env.development; both are gitignored. Never put a real value in this file.

# Public address of the site, used for metadataBase. Empty falls back to the
# Vercel production domain, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# PostHog browser analytics (public by design, shipped in the bundle).
# PostHog starts only when NEXT_PUBLIC_VERCEL_ENV is "production".
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
# NEXT_PUBLIC_VERCEL_ENV is set by Vercel itself; never set it by hand.

# Server-only. Stripe payments and webhook verification.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret of the webhook endpoint /api/stripe/webhook (Stripe Dashboard).
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Set to true after configuring Stripe Tax; anything else sends no tax parameters.
STRIPE_AUTOMATIC_TAX=

# Tests only. true makes Stripe calls hit an in-process mock (src/instrumentation.ts).
E2E_MOCK_STRIPE=
# Tests only. true makes Resend calls hit an in-process mock (src/instrumentation.ts).
E2E_MOCK_RESEND=

# Server-only. Resend transactional email (the confirmation email after payment).
RESEND_API_KEY=re_replace_me
# Sender of both emails, on the domain verified in Resend.
EMAIL_FROM="Your Name <you@your-verified-domain.example>"
# Reply-to of the buyer email and recipient of the owner notice.
EMAIL_REPLY_TO=you@example.com
# The "Book your call" link in the buyer email; must be an https URL.
BOOKING_URL=https://your-booking-tool.example/discovery-call

# ---------------------------------------------------------------------------
# ADW toolkit (read from .env.development by adws/, symlinked in from the
# adw-toolkit checkout). Paths and names, no secrets. GitHub access comes from
# `gh auth login`, not from a token here.
# ---------------------------------------------------------------------------
# Path to the Claude Code CLI; `claude` if it is on PATH.
CLAUDE_CODE_PATH=claude
# Absolute path of this checkout. Everything a run writes (agents/, trees/) lands under it.
ADW_PROJECT_ROOT=/absolute/path/to/edit-issebya
# Branch new worktrees branch from and pull requests target.
ADW_BASE_BRANCH=develop
# Name shown for this project in the ADW dashboard; seeds a new project row only.
ADW_UI_DISPLAY_NAME=edit.issebya.com
