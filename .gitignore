.vercel
.DS_Store

# ADW toolkit: symlinked in from the adw-toolkit checkout, never committed here.
# `adws` is the engine, `.claude` holds the symlinked slash commands (no trailing
# slash: inside a worktree .claude is a symlink, which a `dir/` rule would miss).
# `agents/` and `trees/` are what a run writes; `.ports.env` is written into
# each worktree by the engine. `.adw/project.md` is NOT ignored on purpose.
adws
agents/
trees/
.claude
.ports.env

# generated by Next on every `dev` and `build`. The import inside flips between
# ./.next/dev/types/routes.d.ts (dev) and ./.next/types/routes.d.ts (build),
# so tracking it would turn every build into a diff.
next-env.d.ts

# Playwright MCP writes snapshots and console logs here during ADW reviews; never commit them
.playwright-mcp/
# browser_snapshot dumps saved to the repo root by a test or review journey (s9.yml, s18b.yml)
/s[0-9]*.yml

# @playwright/test output (yarn test:e2e); never commit it
playwright-report/
test-results/
blob-report/

# The storage double's folder (E2E_MOCK_STORAGE=true): written by the studio's
# mock route and read by the worker; never commit it.
.e2e-storage/

# Vitest browser mode's failure screenshots (packages/edit); never commit them
.vitest/
