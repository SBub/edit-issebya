# Placeholder names only, for the studio (apps/studio, served at /studio).
# Copy to apps/studio/.env.development (next dev) and apps/studio/.env.production
# (next build / next start); both are gitignored. On Vercel the production values
# live in the project's environment settings. Never put a real value in this file.
# [differs] marks a value that changes between development and production.

# [differs] Public address the studio is reached at, used for login redirect
# links. Development http://localhost:3000 (through the landing page), production
# https://edit.issebya.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [differs] Supabase. Development uses the local stack from `supabase start`
# (http://127.0.0.1:54431 and the publishable key `supabase status` prints);
# production uses the hosted project. Never point development at production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public by design: row-level security protects the rows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Cloudflare R2. Server-only keys: they sign upload and download links.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=your_bucket_name
# eu when the bucket was created with the EU jurisdiction, empty otherwise.
R2_JURISDICTION=eu
R2_STUDIO_ACCESS_KEY_ID=replace_me
R2_STUDIO_SECRET_ACCESS_KEY=replace_me
# [differs] Folder inside the bucket, so development and production files never mix.
R2_KEY_PREFIX=dev/

# [differs] PostHog browser analytics (public by design). Leave empty in
# development so test clicks never reach the production project.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Tests only, on only when exactly true: multipart uploads go to the folder fake
# in .e2e-storage/ at the repository root (through /studio/api/e2e-storage-mock,
# R2's S3 API stand-in) instead of R2.
E2E_MOCK_STORAGE=
