{
  "name": "@edit-issebya/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${STUDIO_PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${STUDIO_PORT:-3001}",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "e2e:sign-in-url": "node --env-file-if-exists=../worker/.env.development --env-file-if-exists=.env.development scripts/e2e-sign-in-url.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@edit-issebya/storage": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@uppy/aws-s3": "6.3.0",
    "@uppy/core": "6.3.0",
    "next": "16.3.8",
    "posthog-js": "^1.438.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.2.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
