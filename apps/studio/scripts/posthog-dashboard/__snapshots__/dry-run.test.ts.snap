              "x": 0,
              "y": 30,
            },
          },
        },
        {
          "layouts": {
            "sm": {
              "h": 2,
              "w": 6,
              "x": 0,
              "y": 35,
            },
          },
          "text": {
            "body": "**Supabase usage** (database size, egress, auth users) is not synced to PostHog. Read it on the studio project's usage page: https://supabase.com/dashboard/project/<studio-project-ref>/settings/usage

[studio-metrics:supabase-usage]",
          },
        },
        {
          "layouts": {
            "sm": {
              "h": 2,
              "w": 6,
              "x": 6,
              "y": 35,
            },
          },
          "text": {
            "body": "**Preview matches export guardrail.** Checked by \`apps/studio/e2e-tools/export-matches-preview.spec.ts\`, run on the owner's Mac by \`yarn workspace @edit-issebya/studio test:tools\`, never in CI. Its last result is the owner's terminal output; the accepted scores and bound are in app_docs/export.md.

[studio-metrics:guardrail]",
          },
        },
      ],
    },
    "method": "PATCH",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/dashboards/<id:dashboard>/",
  },
]
`;
