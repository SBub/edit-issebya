// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`dry run payloads > match the committed snapshot 1`] = `
[
  {
    "body": {
      "description": "Does the studio turn a two-hour edit into a short one, and what does each reel cost to make? Built from code in apps/studio/scripts/posthog-dashboard/: change it there, not here.

[studio-metrics:dashboard]",
      "name": "Studio MVP metrics",
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/dashboards/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "The main metric. Each bar is one exported reel: minutes from upload to its first export. Lower is better; the goal is under 30 minutes.

[studio-metrics:main-metric]",
      "name": "Studio: upload to export, minutes per reel",
      "query": {
        "chartSettings": {
          "goalLines": [
            {
              "displayLabel": true,
              "label": "30 minutes",
              "value": 30,
            },
          ],
          "xAxis": {
            "column": "exported_at",
          },
          "yAxis": [
            {
              "column": "minutes",
            },
          ],
        },
        "display": "ActionsBar",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "with uploads as (
  select jobs.reel_id as reel_id, min(jobs.created_at) as uploaded_at
  from supabase_jobs as jobs
  where jobs.kind = 'process'
  group by jobs.reel_id
),
first_exports as (
  select exports.reel_id as reel_id, min(exports.created_at) as exported_at
  from supabase_exports as exports
  group by exports.reel_id
),
exported_reels as (
  select uploads.reel_id as reel_id, first_exports.exported_at as exported_at,
    dateDiff('second', uploads.uploaded_at, first_exports.exported_at) / 60.0 as minutes
  from uploads
  inner join first_exports on first_exports.reel_id = uploads.reel_id
)
select exported_reels.reel_id as reel_id, exported_reels.exported_at as exported_at,
  exported_reels.minutes as minutes
from exported_reels
order by exported_reels.exported_at",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "How many of the latest exported reels in a row took under 30 minutes from upload to export. Higher is better; the goal is 7 in a row. A slower reel resets it to 0.

[studio-metrics:main-metric-streak]",
      "name": "Studio: reels in a row under 30 minutes",
      "query": {
        "chartSettings": {},
        "display": "BoldNumber",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "with uploads as (
  select jobs.reel_id as reel_id, min(jobs.created_at) as uploaded_at
  from supabase_jobs as jobs
  where jobs.kind = 'process'
  group by jobs.reel_id
),
first_exports as (
  select exports.reel_id as reel_id, min(exports.created_at) as exported_at
  from supabase_exports as exports
  group by exports.reel_id
),
exported_reels as (
  select uploads.reel_id as reel_id, first_exports.exported_at as exported_at,
    dateDiff('second', uploads.uploaded_at, first_exports.exported_at) / 60.0 as minutes
  from uploads
  inner join first_exports on first_exports.reel_id = uploads.reel_id
),
ranked as (
  select exported_reels.minutes as minutes,
    row_number() over (order by exported_reels.exported_at desc) as recency
  from exported_reels
)
select coalesce(
  min(case when ranked.minutes >= 30 then ranked.recency else null end) - 1,
  count(*)
) as streak
from ranked",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Each bar is one reel: minutes from upload until its first preview can be watched. Lower is better; the goal is under 15 minutes.

[studio-metrics:first-preview]",
      "name": "Studio: upload to first preview, minutes per reel",
      "query": {
        "chartSettings": {
          "goalLines": [
            {
              "displayLabel": true,
              "label": "15 minutes",
              "value": 15,
            },
          ],
          "xAxis": {
            "column": "previewed_at",
          },
          "yAxis": [
            {
              "column": "minutes",
            },
          ],
        },
        "display": "ActionsBar",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "with uploads as (
  select jobs.reel_id as reel_id, min(jobs.created_at) as uploaded_at
  from supabase_jobs as jobs
  where jobs.kind = 'process'
  group by jobs.reel_id
),
first_versions as (
  select versions.reel_id as reel_id, min(versions.created_at) as previewed_at
  from supabase_versions as versions
  group by versions.reel_id
)
select uploads.reel_id as reel_id, first_versions.previewed_at as previewed_at,
  dateDiff('second', uploads.uploaded_at, first_versions.previewed_at) / 60.0 as minutes
from uploads
inner join first_versions on first_versions.reel_id = uploads.reel_id
order by first_versions.previewed_at",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Average number of changes asked for on a reel before its first export, by week of export. Lower means the first edit was closer to what was wanted.

[studio-metrics:changes-per-reel]",
      "name": "Studio: change requests per exported reel, by week",
      "query": {
        "chartSettings": {
          "xAxis": {
            "column": "week",
          },
          "yAxis": [
            {
              "column": "changes_per_reel",
            },
          ],
        },
        "display": "ActionsBar",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "with first_exports as (
  select exports.reel_id as reel_id, min(exports.created_at) as exported_at
  from supabase_exports as exports
  group by exports.reel_id
),
reel_changes as (
  select first_exports.reel_id as reel_id, first_exports.exported_at as exported_at,
    sum(case when jobs.kind = 'change' and jobs.created_at < first_exports.exported_at then 1 else 0 end) as change_requests
  from first_exports
  inner join supabase_jobs as jobs on jobs.reel_id = first_exports.reel_id
  group by first_exports.reel_id, first_exports.exported_at
)
select toStartOfWeek(reel_changes.exported_at, 1) as week,
  sum(reel_changes.change_requests) * 1.0 / count(*) as changes_per_reel,
  count(*) as exported_reels
from reel_changes
group by toStartOfWeek(reel_changes.exported_at, 1)
order by week",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Each week: reels uploaded, and how many of those were exported. The closer the two bars, the more uploads end as a finished reel.

[studio-metrics:completion]",
      "name": "Studio: uploaded and exported reels, by week",
      "query": {
        "chartSettings": {
          "xAxis": {
            "column": "week",
          },
          "yAxis": [
            {
              "column": "uploaded_reels",
            },
            {
              "column": "exported_reels",
            },
          ],
        },
        "display": "ActionsBar",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "with uploads as (
  select jobs.reel_id as reel_id, min(jobs.created_at) as uploaded_at
  from supabase_jobs as jobs
  where jobs.kind = 'process'
  group by jobs.reel_id
)
select toStartOfWeek(uploads.uploaded_at, 1) as week,
  count(*) as uploaded_reels,
  sum(case when uploads.reel_id in (select exports.reel_id from supabase_exports as exports) then 1 else 0 end) as exported_reels,
  sum(case when uploads.reel_id in (select exports.reel_id from supabase_exports as exports) then 1 else 0 end) * 1.0 / count(*) as completion
from uploads
group by toStartOfWeek(uploads.uploaded_at, 1)
order by week",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "How far reels get through upload, open preview, ask for a change, export and download, within 14 days. A big drop shows where reels stall. Counts only reels where tracking was on, so it can read low.

[studio-metrics:funnel]",
      "name": "Studio: funnel by reel",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "dateRange": {
            "date_from": "-90d",
          },
          "funnelsFilter": {
            "funnelAggregateByHogQL": "properties.reel_id",
            "funnelOrderType": "ordered",
            "funnelVizType": "steps",
            "funnelWindowInterval": 14,
            "funnelWindowIntervalUnit": "day",
          },
          "kind": "FunnelsQuery",
          "properties": [
            {
              "key": "app",
              "operator": "exact",
              "type": "event",
              "value": [
                "studio",
              ],
            },
          ],
          "series": [
            {
              "event": "studio_footage_uploaded",
              "kind": "EventsNode",
              "name": "studio_footage_uploaded",
            },
            {
              "event": "studio_preview_opened",
              "kind": "EventsNode",
              "name": "studio_preview_opened",
            },
            {
              "event": "studio_change_requested",
              "kind": "EventsNode",
              "name": "studio_change_requested",
            },
            {
              "event": "studio_export_requested",
              "kind": "EventsNode",
              "name": "studio_export_requested",
            },
            {
              "event": "studio_export_downloaded",
              "kind": "EventsNode",
              "name": "studio_export_downloaded",
            },
          ],
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "One row per reel: machine time, memory, data moved, AI tokens and the AI cost Claude reports. Higher means the reel cost more to make. Machine time is not turned into money.

[studio-metrics:cost-per-reel]",
      "name": "Studio: cost per reel",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select steps.reel_id as reel_id,
  coalesce(sum(steps.wall_ms), 0) / 1000.0 as wall_seconds,
  coalesce(sum(steps.cpu_ms), 0) / 1000.0 as cpu_seconds,
  coalesce(max(steps.peak_rss_bytes), 0) as peak_memory_bytes,
  coalesce(sum(steps.bytes_in), 0) as input_bytes,
  coalesce(sum(steps.bytes_out), 0) as output_bytes,
  coalesce(sum(steps.ai_input_tokens), 0) as ai_tokens_in,
  coalesce(sum(steps.ai_output_tokens), 0) as ai_tokens_out,
  coalesce(sum(steps.ai_cost_usd), 0) as ai_reported_cost_usd,
  count(*) as step_runs
from supabase_steps as steps
where steps.reel_id is not null
group by steps.reel_id
order by min(steps.started_at)",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "The same totals as cost per reel, but per step, so you see which step uses the most time, memory or AI. Machine time is not turned into money.

[studio-metrics:cost-per-step]",
      "name": "Studio: cost per step",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select steps.name as step_name,
  coalesce(sum(steps.wall_ms), 0) / 1000.0 as wall_seconds,
  coalesce(sum(steps.cpu_ms), 0) / 1000.0 as cpu_seconds,
  coalesce(max(steps.peak_rss_bytes), 0) as peak_memory_bytes,
  coalesce(sum(steps.bytes_in), 0) as input_bytes,
  coalesce(sum(steps.bytes_out), 0) as output_bytes,
  coalesce(sum(steps.ai_input_tokens), 0) as ai_tokens_in,
  coalesce(sum(steps.ai_output_tokens), 0) as ai_tokens_out,
  coalesce(sum(steps.ai_cost_usd), 0) as ai_reported_cost_usd,
  count(*) as step_runs
from supabase_steps as steps
group by steps.name
order by steps.name",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "How long each step takes for reels of different lengths (in 15-second bands). If time grows faster than length, that step will slow down longer reels. Successful runs only.

[studio-metrics:step-time-vs-length]",
      "name": "Studio: time per step against reel length",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select steps.name as step_name, floor(reels.source_seconds / 15) * 15 as source_seconds_from,
  count(steps.id) as done_steps,
  median(steps.wall_ms / 1000.0) as median_seconds,
  max(steps.wall_ms / 1000.0) as max_seconds,
  median(steps.wall_ms / 1000.0 / nullif(reels.footage_seconds, 0)) as median_seconds_per_footage_second
from supabase_steps as steps
inner join supabase_reels as reels on reels.id = steps.reel_id
where steps.status = 'done' and reels.source_seconds is not null
group by steps.name, floor(reels.source_seconds / 15) * 15
order by step_name, source_seconds_from",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Share of runs that failed, per step and week. Lower is better; a rising share points to the step to fix.

[studio-metrics:failed-steps]",
      "name": "Studio: failed steps, by step and week",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select toStartOfWeek(steps.started_at, 1) as week, steps.name as step_name,
  sum(case when steps.status = 'failed' then 1 else 0 end) as failed_steps,
  count(*) as finished_steps,
  sum(case when steps.status = 'failed' then 1 else 0 end) * 1.0 / count(*) as failed_share
from supabase_steps as steps
where steps.status in ('done', 'failed')
group by toStartOfWeek(steps.started_at, 1), steps.name
order by week, step_name",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Total bytes stored right now, with a file shared by several reels counted once, and the number of files. Deleted files are not counted.

[studio-metrics:storage-total]",
      "name": "Studio: live storage in total",
      "query": {
        "chartSettings": {},
        "display": "BoldNumber",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "with live_objects as (
  select stored_files.r2_key as r2_key,
    max(stored_files.bytes) as object_bytes,
    sum(stored_files.bytes) as row_bytes
  from supabase_stored_files as stored_files
  where stored_files.deleted_at is null
  group by stored_files.r2_key
)
select coalesce(sum(live_objects.object_bytes), 0) as total_bytes,
  coalesce(sum(live_objects.row_bytes), 0) as per_reel_row_bytes,
  count(*) as live_objects
from live_objects",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Bytes stored right now for each reel. A file shared by two reels counts for both, so the rows can add up to more than the total.

[studio-metrics:storage-per-reel]",
      "name": "Studio: live storage per reel",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select stored_files.reel_id as reel_id,
  sum(stored_files.bytes) as live_bytes,
  count(*) as live_files
from supabase_stored_files as stored_files
where stored_files.deleted_at is null and stored_files.reel_id is not null
group by stored_files.reel_id
order by live_bytes desc, reel_id",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Bytes stored right now, by the step that made the files: shows which step fills storage most. A file shared by two reels counts for both.

[studio-metrics:storage-per-step]",
      "name": "Studio: live storage per step",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select stored_files.step as step_name,
  sum(stored_files.bytes) as live_bytes,
  count(*) as live_files
from supabase_stored_files as stored_files
where stored_files.deleted_at is null
group by stored_files.step
order by live_bytes desc, step_name",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Share of steps skipped because their result was already saved, by week and to date. Higher means less repeated work and faster edits.

[studio-metrics:cache-hit-rate]",
      "name": "Studio: cache hit rate, by week",
      "query": {
        "chartSettings": {
          "xAxis": {
            "column": "week",
          },
          "yAxis": [
            {
              "column": "hit_rate",
            },
            {
              "column": "hit_rate_to_date",
            },
          ],
        },
        "display": "ActionsLineGraph",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "with weekly as (
  select toStartOfWeek(steps.started_at, 1) as week,
    sum(case when steps.cache_hit then 1 else 0 end) as cache_hits,
    count(*) as finished_steps
  from supabase_steps as steps
  where steps.status in ('done', 'failed', 'skipped')
  group by toStartOfWeek(steps.started_at, 1)
)
select weekly.week as week, weekly.cache_hits as cache_hits, weekly.finished_steps as finished_steps,
  weekly.cache_hits * 1.0 / weekly.finished_steps as hit_rate,
  sum(weekly.cache_hits) over (order by weekly.week) * 1.0
    / sum(weekly.finished_steps) over (order by weekly.week) as hit_rate_to_date
from weekly
order by weekly.week",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "How many jobs the worker was given each day, by kind, whatever happened to them. Shows how much work comes in.

[studio-metrics:jobs-per-day]",
      "name": "Studio: jobs per day, by kind",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select toStartOfDay(jobs.created_at) as day, jobs.kind as job_kind,
  count(*) as jobs
from supabase_jobs as jobs
group by toStartOfDay(jobs.created_at), jobs.kind
order by day, job_kind",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Hours each day the worker spent running jobs, and that as a share of 24 hours. Close to 24 means it is at capacity. Approximate: a restarted job counts only its last try.

[studio-metrics:worker-busy-hours]",
      "name": "Studio: worker busy hours per day",
      "query": {
        "chartSettings": {
          "xAxis": {
            "column": "day",
          },
          "yAxis": [
            {
              "column": "busy_hours",
            },
          ],
        },
        "display": "ActionsBar",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select toStartOfDay(jobs.started_at) as day,
  sum(dateDiff('second', jobs.started_at, jobs.finished_at)) / 3600.0 as busy_hours,
  sum(dateDiff('second', jobs.started_at, jobs.finished_at)) / 86400.0 as busy_share,
  count(*) as finished_jobs
from supabase_jobs as jobs
where jobs.status in ('done', 'failed') and jobs.started_at is not null and jobs.finished_at is not null
group by toStartOfDay(jobs.started_at)
order by day",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "How long jobs take to run, per kind and week: typical (median) and slow (95th percentile) minutes. Lower is better. A restarted job counts only its last try.

[studio-metrics:job-run-time]",
      "name": "Studio: job run time per kind, by week",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select toStartOfWeek(jobs.started_at, 1) as week, jobs.kind as job_kind,
  count(*) as done_jobs,
  median(dateDiff('second', jobs.started_at, jobs.finished_at) / 60.0) as median_minutes,
  quantile(0.95)(dateDiff('second', jobs.started_at, jobs.finished_at) / 60.0) as p95_minutes
from supabase_jobs as jobs
where jobs.status = 'done' and jobs.started_at is not null and jobs.finished_at is not null
group by toStartOfWeek(jobs.started_at, 1), jobs.kind
order by week, job_kind",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Minutes jobs wait before the worker starts them, per kind and week: typical (median) and slow (95th percentile). Lower is better. Approximate: a restarted job's wait includes its lost try, and a job also waits for earlier jobs of its reel.

[studio-metrics:queue-wait]",
      "name": "Studio: queue wait per kind, by week (approximate)",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select toStartOfWeek(jobs.created_at, 1) as week, jobs.kind as job_kind,
  count(*) as claimed_jobs,
  median(dateDiff('second', jobs.created_at, jobs.started_at) / 60.0) as median_wait_minutes,
  quantile(0.95)(dateDiff('second', jobs.created_at, jobs.started_at) / 60.0) as p95_wait_minutes
from supabase_jobs as jobs
where jobs.started_at is not null
group by toStartOfWeek(jobs.created_at, 1), jobs.kind
order by week, job_kind",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Share of worker time spent on steps that call Claude, by week. Higher means Claude, not the Mac, is the bottleneck. An upper bound: the whole step counts, not only the wait.

[studio-metrics:ai-wait-share]",
      "name": "Studio: share of worker time waiting on Claude, by week",
      "query": {
        "chartSettings": {
          "xAxis": {
            "column": "week",
          },
          "yAxis": [
            {
              "column": "ai_share",
            },
          ],
        },
        "display": "ActionsLineGraph",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select toStartOfWeek(steps.started_at, 1) as week,
  sum(case when steps.ai_model is not null then steps.wall_ms else 0 end) / 1000.0 as ai_wall_seconds,
  sum(steps.wall_ms) / 1000.0 as wall_seconds,
  sum(case when steps.ai_model is not null then steps.wall_ms else 0 end) * 1.0
    / nullif(sum(steps.wall_ms), 0) as ai_share
from supabase_steps as steps
where steps.wall_ms is not null
group by toStartOfWeek(steps.started_at, 1)
order by week",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
    "body": {
      "dashboards": [
        "<id:dashboard>",
      ],
      "description": "Per step: typical CPU seconds for each minute of uploaded video, and the most memory it used. Use it to size a server. Raw machine measurements, no money.

[studio-metrics:capacity-per-minute]",
      "name": "Studio: CPU per source minute and peak memory, per step",
      "query": {
        "chartSettings": {},
        "display": "ActionsTable",
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "select steps.name as step_name,
  count(steps.id) as done_steps,
  median(steps.cpu_ms / 1000.0 / (reels.source_seconds / 60.0)) as median_cpu_seconds_per_source_minute,
  max(steps.peak_rss_bytes) as max_peak_memory_bytes
from supabase_steps as steps
inner join supabase_reels as reels on reels.id = steps.reel_id
where steps.status = 'done' and not steps.cache_hit and reels.source_seconds is not null
group by steps.name
order by step_name",
        },
      },
      "tags": [
        "studio-metrics",
      ],
    },
    "method": "POST",
    "path": "/api/projects/<POSTHOG_PROJECT_ID>/insights/",
  },
  {
