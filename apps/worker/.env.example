# Placeholder names only, for the worker (apps/worker). It is not a Next.js app,
# so it loads its file explicitly: node --env-file=.env.development (or
# .env.production). Copy to apps/worker/.env.development and
# apps/worker/.env.production; both are gitignored. The worker runs on the
# owner's machine; these values never go to Vercel. Never put a real value here.
# Variables already in the environment win over the file.
# [differs] marks a value that changes between development and production.

# [differs] Supabase. Development uses the local stack from `supabase start`
# (http://127.0.0.1:54431 and the secret key `supabase status` prints);
# production uses the hosted project.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key: bypasses row-level security. Worker only, never anywhere else.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Cloudflare R2, read and write.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=your_bucket_name
R2_JURISDICTION=eu
R2_WORKER_ACCESS_KEY_ID=replace_me
R2_WORKER_SECRET_ACCESS_KEY=replace_me
# [differs] Same folder as the studio of the same mode.
R2_KEY_PREFIX=dev/

# [differs] PostHog events, logs, traces and errors. Leave the token empty in
# development.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://your-posthog-host
# OpenTelemetry export to PostHog (logs and traces). The SDK appends /v1/logs and
# /v1/traces to the endpoint. The header carries the project token. The endpoint
# alone turns export on; the header is optional (a local collector needs none, so
# leave it empty there).
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-posthog-host/i
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your_posthog_project_token
OTEL_SERVICE_NAME=edit-issebya-worker
# In development, filling the two OTEL_EXPORTER_OTLP_* lines in .env.development
# exports development traces and logs to the same PostHog project; set
# OTEL_SERVICE_NAME=edit-issebya-worker-dev there to tell them apart.
# `yarn dev:studio` runs the worker in Docker and sends it to the local Grafana by
# itself (compose.yaml sets the endpoint and empties the header), whatever is here.
# POSTHOG_PROJECT_TOKEN stays empty in development (error tracking is
# production only).

# [differs] Name of this worker in leases and heartbeats.
WORKER_ID=your-machine-dev
# Seconds between checks of the job table when Realtime is quiet.
WORKER_POLL_INTERVAL_SECONDS=120
# No new job below this much free disk on the scratch volume; the reason shows
# in the studio under a queued job.
WORKER_MIN_FREE_DISK_GB=10
# [differs] Temporary files of running jobs, one folder per job, removed after it.
WORKER_SCRATCH_DIR=/absolute/path/to/scratch/dev
# [differs] The OpenRouter API key every AI call uses (Claude Haiku 5.5 through
# OpenRouter). Secret: never commit it; the doctor checks it is set and never
# prints it.
OPENROUTER_API_KEY=
# The prompts the decide and describe_photo calls send are fetched from PostHog by name at POSTHOG_PROMPT_LABEL from POSTHOG_PROJECT_ID (their text is never in the repository; app_docs/decide-step.md, "Prompts"); the fetch uses POSTHOG_PERSONAL_API_KEY and POSTHOG_HOST.
# Numeric project id the prompts are read from: PostHog project settings, General, Project ID. Not secret.
POSTHOG_PROJECT_ID=312096
# Secret personal API key with only the llm_prompt:read scope, restricted to this project: PostHog user settings, Personal API keys, this project only. Never commit it.
POSTHOG_PERSONAL_API_KEY=phx_replace_me
POSTHOG_PROMPT_LABEL=production
# Tools on this machine.
FFMPEG_PATH=/absolute/path/to/ffmpeg
HYPERFRAMES_NO_TELEMETRY=1

# Tests only, each on only when exactly true. E2E_MOCK_AI replaces OpenRouter
# with scripted answers (never a network call); E2E_MOCK_STORAGE makes storage calls use the folder
# fake in .e2e-storage/ at the repository root instead of R2.
E2E_MOCK_AI=
E2E_MOCK_STORAGE=
# Tests only, on only when exactly true: the placeholder prompts replace PostHog's
# (no key, no network), so every AI call names reel-*@v1 and photo-describe@v1.
E2E_MOCK_PROMPTS=
# Tests only: a JSON file of scripted model replies the AI double replays (a reply
# naming "role": "hook" answers the hook call; the others answer the rest, in order).
E2E_MOCK_AI_SCRIPT=
# Tests only, read only when E2E_MOCK_STORAGE is exactly true: the free disk in
# GB the disk guard sees, whatever the disk says.
E2E_MOCK_FREE_DISK_GB=
# Tests only, on only when exactly true: the pipeline step double. A fixed step
# that must run copies its committed output from fixtures/pipeline/ (the
# fixture clip only) instead of running its tool.
E2E_MOCK_STEPS=
# Tests only, read only when E2E_MOCK_STEPS is exactly true: one step that
# fails on purpose, as <step>:<signal|exit|half>.
E2E_MOCK_STEP_FAULT=
