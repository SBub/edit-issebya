              "step.cpu_ms": "CPU time",
              "step.peak_rss_bytes": "Peak memory",
              "step.bytes_in": "Bytes in",
              "step.bytes_out": "Bytes out",
              "step.cache_hit": "Cache hit"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
