    {
      "id": 12,
      "type": "table",
      "title": "Per step: time, cores, memory, bytes",
      "description": "One row per step span of the chosen reel, oldest first. Wall time, CPU time, peak memory and bytes in and out are the step row's own measurements (the span's step.* attributes); average cores is CPU time divided by wall time: near the core count is CPU-bound, far under 1 means the step waited (network, disk, the database or the AI). In-process steps (first_version, restore) and cache hits have no CPU or memory. At most 100 step spans are shown.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 20,
          "spss": 100,
          "query": "{ trace:id = \"$reel\" && name =~ \"step .*\" } | select(span.step.wall_ms, span.step.cpu_ms, span.step.peak_rss_bytes, span.step.bytes_in, span.step.bytes_out, span.step.cache_hit)"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Average cores",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "step.cpu_ms"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "step.wall_ms"
                }
              }
            },
            "replaceFields": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Start time"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true,
              "traceService": true,
              "traceName": true,
              "spanID": true
            },
            "indexByName": {
              "Start time": 0,
              "Name": 1,
              "Duration": 2,
              "step.wall_ms": 3,
              "step.cpu_ms": 4,
              "Average cores": 5,
              "step.peak_rss_bytes": 6,
              "step.bytes_in": 7,
              "step.bytes_out": 8,
              "step.cache_hit": 9
            },
            "renameByName": {
