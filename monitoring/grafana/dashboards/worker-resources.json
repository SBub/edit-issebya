    {
      "id": 10,
      "type": "row",
      "title": "The reel's steps (variable reel = the reel's id without dashes)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Steps on the metrics' time axis",
      "description": "Each block is one step of the chosen reel, from its start to its end, on the same time axis as the panels above (the crosshair is shared). Read a step's CPU, memory, network and disk straight above its block. A cache hit is too short to see.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 20,
          "spss": 100,
          "query": "{ trace:id = \"$reel\" && name =~ \"step .*\" }"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "B",
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 20,
          "spss": 100,
          "query": "{ trace:id = \"$reel\" && name =~ \"step .*\" }"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "filter": {
            "id": "byRefId",
            "options": "B"
          },
          "options": {
            "mode": "binary",
            "alias": "ms",
            "binary": {
              "left": {
                "matcher": {
