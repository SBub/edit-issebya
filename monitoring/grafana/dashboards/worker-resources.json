    {
      "id": 10,
      "type": "row",
      "title": "The reel's steps (variable reel = the reel's id without dashes)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Steps on the metrics' time axis",
      "description": "One row per step name of the chosen reel, one bar per run of that step from its start to its end, on the same time axis as the panels above (the crosshair is shared). Read a step's CPU, memory, network and disk straight above its bar. A step that runs inside another (cutout inside decide) has its own row. The bars come from the reel's whole trace, read by id; each end is an explicit idle state, so a bar stops where the step stopped. A cache hit is too short to see.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "tempo-trace-json"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "tempo-trace-json"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/api/traces/${reel}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
